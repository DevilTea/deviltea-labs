{
	"name": "vue-temp-var",
	"type": "module",
	"version": "2.0.1",
	"description": "A Vue component for defining temporary variables in the template with type inference.",
	"author": {
		"name": "DevilTea",
		"email": "ch19980814@gmail.com"
	},
	"license": "MIT",
	"homepage": "https://github.com/DevilTea/deviltea-labs/tree/main/packages/vue-temp-var#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevilTea/deviltea-labs.git",
		"directory": "packages/vue-temp-var"
	},
	"bugs": {
		"url": "https://github.com/DevilTea/deviltea-labs/issues"
	},
	"keywords": [
		"vue",
		"vue3"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
