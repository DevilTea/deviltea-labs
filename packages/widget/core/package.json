{
	"name": "@deviltea/widget-core",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.0.1",
	"author": "DevilTea <ch19980814@gmail.com>",
	"license": "MIT",
	"homepage": "https://github.com/DevilTea/deviltea-labs/tree/main/packages/widget/core#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevilTea/deviltea-labs.git",
		"directory": "packages/widget/core"
	},
	"bugs": {
		"url": "https://github.com/DevilTea/deviltea-labs/issues"
	},
	"keywords": [
		"widget",
		"composition",
		"plugin",
		"blueprint",
		"runtime",
		"signals"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./inspection": {
			"types": "./dist/inspection/index.d.mts",
			"import": "./dist/inspection/index.mjs"
		}
	},
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"files": [
		"dist"
	],
	"engines": {
		"node": "^22.14.0 || ^24.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"build:pack": "pnpm build && pnpm pack",
		"dev": "tsdown --watch",
		"test": "vitest run --config vitest.config.ts",
		"typecheck": "pnpm typecheck:package && pnpm typecheck:test",
		"typecheck:package": "tsc --project ./tsconfig.package.json --noEmit",
		"typecheck:test": "tsc --project ./tsconfig.tests.json --noEmit"
	},
	"dependencies": {
		"alien-signals": "catalog:"
	},
	"devDependencies": {
		"tsdown": "catalog:",
		"vitest": "catalog:"
	}
}
