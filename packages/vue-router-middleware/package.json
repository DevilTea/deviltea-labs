{
	"name": "@deviltea/vue-router-middleware",
	"type": "module",
	"version": "0.0.4",
	"description": "A simple router middleware system implemented by beforeEach guard.",
	"author": "DevilTea <ch870814@gmail.com>",
	"license": "MIT",
	"homepage": "https://github.com/DevilTea/deviltea-labs/tree/main/packages/vue-router-middleware#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevilTea/deviltea-labs.git",
		"directory": "packages/vue-router-middleware"
	},
	"bugs": {
		"url": "https://github.com/DevilTea/deviltea-labs/issues"
	},
	"keywords": [],
	"sideEffects": false,
	"exports": {
		".": {
			"types": {
				"import": "./dist/index.d.mts",
				"require": "./dist/index.d.cts",
				"default": "./dist/index.d.ts"
			},
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"*": [
				"./dist/*",
				"./dist/index.d.ts"
			]
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "unbuild",
		"dev": "unbuild --stub",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "pnpm build",
		"release": "bumpp && pnpm publish",
		"start": "tsx src/index.ts",
		"test": "vitest",
		"test:cov": "vitest --coverage",
		"typecheck": "tsc --noEmit --project tsconfig.test.json",
		"prepare": "simple-git-hooks"
	},
	"peerDependencies": {
		"vue": ">=3.0.0",
		"vue-router": ">=4.0.0"
	},
	"devDependencies": {
		"@deviltea/eslint-config": "workspace:^",
		"@deviltea/tsconfig": "workspace:^",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"bumpp": "catalog:",
		"eslint": "catalog:",
		"lint-staged": "catalog:",
		"rimraf": "catalog:",
		"simple-git-hooks": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"unbuild": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:",
		"vue": "catalog:",
		"vue-router": "catalog:"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm lint-staged"
	},
	"lint-staged": {
		"*": "eslint --fix"
	},
	"publishConfig": {
		"access": "public"
	}
}
