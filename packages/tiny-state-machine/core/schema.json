{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["initial", "states"],
	"properties": {
		"id": { "type": "string" },
		"initial": { "type": "string" },
		"states": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"properties": {
					"type": { "const": "final" },
					"on": {
						"type": "object",
						"additionalProperties": { "type": "string" }
					}
				},
				"if": {
					"required": ["type"],
					"properties": { "type": { "const": "final" } }
				},
				"then": {
					"properties": {
						"on": { "type": "object", "maxProperties": 0 }
					}
				}
			}
		}
	}
}
