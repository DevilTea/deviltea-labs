{
	"name": "@deviltea/spec-tool",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"version": "0.0.1",
	"description": "Git-native engineering specification maintenance tool.",
	"author": "DevilTea <ch19980814@gmail.com>",
	"license": "MIT",
	"homepage": "https://github.com/DevilTea/deviltea-labs/tree/main/packages/spec-tool#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevilTea/deviltea-labs.git",
		"directory": "packages/spec-tool"
	},
	"bugs": {
		"url": "https://github.com/DevilTea/deviltea-labs/issues"
	},
	"keywords": [],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"spec": "./dist/cli.mjs"
	},
	"files": [
		"dist",
		"skills"
	],
	"engines": {
		"node": "^22.14.0 || ^24.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"build:pack": "pnpm build && pnpm pack",
		"check": "pnpm test && pnpm test:package && pnpm lint",
		"dev": "tsdown --watch",
		"lint": "eslint .",
		"test": "pnpm --workspace-root exec vitest run --root packages/spec-tool --config vitest.config.ts",
		"test:package": "pnpm build && node test/package-smoke.mjs && node test/v1-process-race.mjs && node test/v1-resource-smoke.mjs && node test/v1-contract-smoke.mjs && node test/v1-lifecycle-smoke.mjs",
		"typecheck": "pnpm typecheck:package && pnpm typecheck:test",
		"typecheck:package": "tsc --project ./tsconfig.package.json --noEmit",
		"typecheck:test": "tsc --project ./tsconfig.tests.json --noEmit"
	},
	"dependencies": {
		"yaml": "catalog:"
	},
	"devDependencies": {
		"tsdown": "catalog:",
		"vitest": "catalog:"
	}
}
