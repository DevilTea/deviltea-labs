{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"mutate": [
		"packages/tiny-state-machine/core/src/index.ts",
		"packages/tiny-state-machine/core/src/transition-engine.ts",
		"packages/tiny-state-machine/core/src/definition.ts",
		"packages/tiny-state-machine/core/src/compiler.ts",
		"packages/tiny-state-machine/core/src/diagnostics.ts",
		"packages/tiny-state-machine/core/src/graph.ts",
		"packages/tiny-state-machine/vue/src/index.ts"
	],
	"testRunner": "vitest",
	"plugins": [
		"@stryker-mutator/vitest-runner"
	],
	"vitest": {
		"configFile": "vitest.mutation.config.ts",
		"related": false
	},
	"coverageAnalysis": "perTest",
	"concurrency": 4,
	"reporters": [
		"clear-text",
		"progress",
		"html",
		"json"
	],
	"thresholds": {
		"high": 95,
		"low": 80,
		"break": 90
	}
}
