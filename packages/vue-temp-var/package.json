		"release": "bumpp && pnpm publish"
	},
	"peerDependencies": {
		"vue": ">=3.3.0"
	},
	"devDependencies": {
		"@deviltea/eslint-config": "workspace:^",
		"@deviltea/tsconfig": "workspace:^",
		"@types/node": "catalog:",
		"bumpp": "catalog:",
