{
	"name": "@deviltea/tsconfig",
	"type": "module",
	"version": "1.0.0",
	"description": "Strict TypeScript 6 presets for platform-neutral, browser, Node.js, and repository tooling projects.",
	"author": "DevilTea <ch19980814@gmail.com>",
	"license": "MIT",
	"homepage": "https://github.com/DevilTea/deviltea-labs/tree/main/packages/tsconfig#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevilTea/deviltea-labs.git",
		"directory": "packages/tsconfig"
	},
	"bugs": {
		"url": "https://github.com/DevilTea/deviltea-labs/issues"
	},
	"keywords": [
		"tsconfig",
		"typescript",
		"strict",
		"browser",
		"node",
		"bundler"
	],
	"exports": {
		"./strict": "./tsconfig.strict.json",
		"./neutral": "./tsconfig.neutral.json",
		"./browser": "./tsconfig.browser.json",
		"./node-bundler": "./tsconfig.node-bundler.json",
		"./node": "./tsconfig.node.json",
		"./tooling": "./tsconfig.tooling.json"
	},
	"files": [
		"docs",
		"tsconfig.*.json"
	],
	"engines": {
		"node": "^22.14.0 || ^24.0.0"
	},
	"scripts": {
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test:contracts": "node ./scripts/test-contracts.mjs --typescript 6.0.3",
		"validate": "pnpm lint && pnpm test:contracts"
	},
	"peerDependencies": {
		"@types/node": "*",
		"typescript": ">=6.0.0 <7.0.0"
	},
	"peerDependenciesMeta": {
		"@types/node": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@deviltea/eslint-config": "workspace:^",
		"bumpp": "catalog:",
		"eslint": "catalog:",
		"typescript": "catalog:"
	}
}
