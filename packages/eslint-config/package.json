{
	"name": "@deviltea/eslint-config",
	"type": "module",
	"version": "9.0.0",
	"description": "DevilTea's opinionated ESLint flat config for JavaScript, TypeScript, and Vue.",
	"author": "DevilTea <ch19980814@gmail.com> (https://github.com/DevilTea/)",
	"license": "MIT",
	"homepage": "https://github.com/DevilTea/deviltea-labs/tree/main/packages/eslint-config#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevilTea/deviltea-labs.git",
		"directory": "packages/eslint-config"
	},
	"bugs": {
		"url": "https://github.com/DevilTea/deviltea-labs/issues"
	},
	"keywords": [
		"eslint",
		"eslint-config",
		"eslintconfig",
		"flat-config",
		"typescript",
		"vue"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": "^22.14.0 || ^24.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"check": "pnpm test && pnpm test:package && pnpm lint",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "pnpm build",
		"test": "pnpm --workspace-root exec vitest run --root packages/eslint-config --config vitest.config.ts",
		"test:coverage": "pnpm --workspace-root exec vitest run --root packages/eslint-config --config vitest.config.ts --coverage",
		"test:package": "pnpm build && node test/package-smoke.mjs"
	},
	"peerDependencies": {
		"eslint": "^10.4.0"
	},
	"dependencies": {
		"@antfu/eslint-config": "catalog:"
	},
	"devDependencies": {
		"bumpp": "catalog:",
		"eslint": "catalog:",
		"publint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	}
}
